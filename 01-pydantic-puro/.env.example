# ============================================================================
#  agentic-base — variaveis de ambiente
# ----------------------------------------------------------------------------
#  Copie este arquivo para `.env` e preencha as chaves que voce for usar.
#  O setup.ps1 ja faz essa copia pra voce.  NUNCA suba o .env pro git.
#
#  Sem nenhuma chave configurada, o projeto roda em MODO DEMO (LLM mockado),
#  entao voce consegue ver a arquitetura funcionando antes de pagar 1 token.
# ============================================================================

# Qual provedor usar: anthropic | openai | gemini | demo
# "demo" forca o LLM mockado mesmo que voce tenha chave. Bom pra testar.
LLM_PROVIDER=demo

# Modelo (vazio = usa um default razoavel do provedor escolhido)
LLM_MODEL=

# Limite de iteracoes do loop agentico (trava de seguranca do curso)
MAX_ITERS=10

# ----------------------------------------------------------------------------
#  Chaves de API — preencha so as que for usar
# ----------------------------------------------------------------------------

# Anthropic (Claude) — https://console.anthropic.com  -> formato sk-ant-...
ANTHROPIC_API_KEY=

# OpenAI (GPT / Codex) — https://platform.openai.com  -> formato sk-proj-...
# OPENAI_API_KEY=

# Google (Gemini / Antigravity) — https://aistudio.google.com/apikey
# GOOGLE_API_KEY=

# Tavily (web search usado em exemplos de tools/RAG da Trilha 2) — https://tavily.com
# TAVILY_API_KEY=

# ----------------------------------------------------------------------------
#  Observabilidade (Trilha 2.8 / 3.8) — descomente quando chegar la
# ----------------------------------------------------------------------------
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
