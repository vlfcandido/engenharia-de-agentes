# Projeto 03 — Google ADK
# Copie para .env (o setup.ps1 ja faz isso). Sem chave = MODO DEMO (offline).

LLM_PROVIDER=demo            # gemini | demo
LLM_MODEL=gemini-2.0-flash
MAX_ITERS=10

# Google AI Studio (Gemini) — chave GRATIS em https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# (ADK tambem usa GOOGLE_GENAI_USE_VERTEXAI=FALSE por padrao p/ AI Studio)
