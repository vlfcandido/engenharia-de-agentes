# Projeto 02 — LangChain + LangGraph
# Copie para .env (o setup.ps1 ja faz isso). Sem chave = MODO DEMO (modelo fake).

LLM_PROVIDER=demo            # anthropic | demo
LLM_MODEL=claude-sonnet-4-6
MAX_ITERS=10

# Anthropic (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Observabilidade (opcional, Trilha 2.8) — LangSmith e nativo no LangChain:
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=agentic-langgraph
